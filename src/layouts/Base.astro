---
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object | object[];
  ogType?: 'profile' | 'article' | 'website';
}

const { title, description, path = '/', jsonLd, ogType = 'website' } = Astro.props;
const canonical = new URL(path, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f5f1" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL('/og-image.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role} at ${site.org}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogType === 'profile' && <meta property="profile:first_name" content="Jacob" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Pichelmann" />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for language models" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
