---
import Base from '../../layouts/Base.astro';
import { projects, type Project } from '../../data/projects';
import { site } from '../../data/site';
import { projectSchema } from '../../lib/schema';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project: p, next } = Astro.props;
---

<Base
  title={`${p.title} | ${site.name}`}
  description={p.summary}
  path={`/projects/${p.slug}/`}
  jsonLd={projectSchema(p)}
  ogType="article"
>
  <article class="project wrap">
    <a class="project__back" href="/#work"><span aria-hidden="true">←</span> All work</a>

    <header class="project__head">
      <p class="eyebrow">{p.kicker} | {p.year}</p>
      <h1 class="project__title">{p.title}</h1>
      <p class="project__lede">{p.summary}</p>
    </header>

    {p.stats && (
      <dl class="project__stats">
        {p.stats.map((s) => (
          <div>
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="project__body">
      <div class="project__content">
        {p.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.paragraphs?.map((para) => <p>{para}</p>)}
            {s.bullets && (
              <ul>
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </section>
        ))}
        {p.quote && (
          <figure class="project__quote">
            <blockquote cite={p.quote.href}>
              <p>“{p.quote.text}”</p>
            </blockquote>
            <figcaption>
              <a href={p.quote.href} target="_blank" rel="noopener">{p.quote.source} <span aria-hidden="true">↗</span></a>
            </figcaption>
          </figure>
        )}
      </div>

      <aside class="project__side">
        {p.people && (
          <div class="project__card">
            <h2 class="project__h">People</h2>
            <p>{p.people}</p>
          </div>
        )}
        {p.links.length > 0 && (
          <div class="project__card">
            <h2 class="project__h">Links</h2>
            <ul class="project__links" role="list">
              {p.links.map((l) => (
                <li>
                  <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                    <span>{l.label}</span>
                    {l.note && <span class="mono">{l.note}</span>}
                    <span aria-hidden="true">{l.href.endsWith('.pdf') ? '↓' : '↗'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <a class="btn" href={`/#${p.entry}`}>
          See it on my path <span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>

    <nav class="project__next" aria-label="Next project">
      <span class="eyebrow">Next</span>
      <a href={`/projects/${next.slug}/`}>{next.title} <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</Base>

<style>
  .project {
    padding-top: 40px;
  }

  .project__back {
    display: inline-flex;
    gap: 6px;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .project__back:hover {
    color: var(--ink);
  }

  .project__head {
    display: grid;
    gap: 16px;
    max-width: 820px;
    margin-top: 40px;
  }

  .project__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .project__lede {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    letter-spacing: -0.015em;
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 58ch;
  }

  .project__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    margin: 48px 0 0;
    border-block: 1px solid var(--rule);
  }

  .project__stats > div {
    padding: 22px 20px 22px 0;
  }

  .project__stats > div + div {
    padding-left: 20px;
    border-left: 1px solid var(--rule);
  }

  .project__stats dt {
    font-size: 2.5rem;
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--career);
  }

  .project__stats dd {
    margin: 6px 0 0;
    color: var(--ink-3);
    font-size: 0.9rem;
  }

  .project__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 64px;
    margin-top: 56px;
    align-items: start;
  }

  .project__content {
    display: grid;
    gap: 40px;
    max-width: 68ch;
  }

  .project__content section {
    display: grid;
    gap: 14px;
  }

  .project__content h2 {
    font-size: 1.4rem;
    letter-spacing: -0.025em;
  }

  .project__content p,
  .project__content li {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .project__content ul {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 8px;
  }

  .project__quote {
    margin: 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--career);
    display: grid;
    gap: 10px;
  }

  .project__quote blockquote {
    margin: 0;
  }

  .project__quote p {
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--ink);
  }

  .project__quote figcaption {
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .project__quote figcaption a {
    color: inherit;
    text-decoration: none;
  }

  .project__quote figcaption a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .project__side {
    position: sticky;
    top: 84px;
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .project__card {
    width: 100%;
    display: grid;
    gap: 10px;
    padding: 20px;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: 0.925rem;
    color: var(--ink-2);
  }

  .project__h {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .project__links a {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 10px;
    align-items: baseline;
    padding: 8px 10px;
    margin-inline: -10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }

  .project__links a:hover {
    background: var(--bg-sunk);
  }

  .project__links .mono {
    color: var(--ink-3);
    font-size: 0.72rem;
    font-weight: 400;
  }

  .project__next {
    display: grid;
    gap: 8px;
    margin-top: 96px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }

  .project__next a {
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    text-decoration: none;
    max-width: 36ch;
  }

  .project__next a:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .project__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .project__side {
      position: static;
    }

    .project__stats > div + div {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
