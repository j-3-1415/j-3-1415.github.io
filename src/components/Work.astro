---
import { projects } from '../data/projects';
---

<section class="section wrap" id="work" aria-labelledby="work-title">
  <div class="section__head">
    <p class="eyebrow">Selected work</p>
    <h2 id="work-title" class="section__title">Things I’m proud of.</h2>
    <p class="section__intro">Clinical evidence, economic research and a few things I’ve built on the side.</p>
  </div>

  <ul class="work" role="list">
    {projects.map((p) => (
      <li>
        <a href={`/projects/${p.slug}/`} class="work__card">
          <span class="work__top">
            <span class="eyebrow">
              {p.area} | {p.year}
            </span>
            <span class="work__arrow" aria-hidden="true">↗</span>
          </span>
          <h3 class="work__title">{p.title}</h3>
          <p class="work__tagline">{p.tagline}</p>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .work {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .work li {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .work__card {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px 26px 32px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .work__card:hover {
    background: var(--bg-elev);
  }

  .work__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .work__arrow {
    color: var(--ink-3);
    transition: transform 0.2s, color 0.2s;
  }

  .work__card:hover .work__arrow {
    color: var(--ink);
    transform: translate(2px, -2px);
  }

  .work__title {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .work__tagline {
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .work__card:hover .work__arrow {
      transform: none;
    }
  }
</style>
